{
  "name": "sutra-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sutrā Studio — the intelligent operations studio for professional event planners.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:e2e:preview": "cross-env E2E_TARGET=preview playwright test --project=desktop --project=mobile",
    "screenshots": "playwright test --project=screens",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NextGenDev-KSK/sutra-studio.git"
  },
  "license": "MIT",
  "keywords": [
    "event-planning",
    "genai",
    "claude",
    "react",
    "typescript",
    "vite",
    "budget",
    "timeline",
    "accessibility"
  ]
}
